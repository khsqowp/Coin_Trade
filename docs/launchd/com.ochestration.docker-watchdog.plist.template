<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ochestration.docker-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/docker_watchdog.sh</string>
    <string>--check-once</string>
  </array>
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>WATCHDOG_STATE_DIR</key><string>__HOME__/Library/Application Support/ochestration-watchdog</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ochestration-watchdog-launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ochestration-watchdog-launchd.error.log</string>
</dict>
</plist>
